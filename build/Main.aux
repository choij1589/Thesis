\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Partial widths of $\ensuremath  {\text  {H}^+}\xspace  $ vs. $\ensuremath  {m_{\ensuremath  {\text  {H}^+}\xspace  }}\xspace  $ in the four 2HDM types at $\tan \beta = 1$ and 5, for three representative $\ensuremath  {m_{\ensuremath  {\text  {A}}\xspace  }}\xspace  $ values. In Type-I and Type-X at larger $\tan \beta $, the bosonic channel $\ensuremath  {\text  {H}^+}\xspace  \to \ensuremath  {\mathrm  {W^+}}\ensuremath  {\text  {A}}\xspace  $ dominates over $\cot ^2\beta $-suppressed fermionic modes. In Type-II and Type-Y, fermionic modes are $\tan \beta $-enhanced, but this mass range is excluded by $b \to s\gamma $ ($\ensuremath  {m_{\ensuremath  {\text  {H}^+}\xspace  }}\xspace  \gtrsim 580$\ensuremath  {\,\text  {Ge\hspace  {-.08em}V}}\xspace  ). The calculation is performed with the 2HDMC\nobreakspace  {}v1.8.0 library.\relax }}{29}{figure.caption.26}\protected@file@percent }
\newlabel{fig:HcDecay}{{2.2}{29}{Partial widths of $\PHp $ vs. $\mHc $ in the four 2HDM types at $\tan \beta = 1$ and 5, for three representative $\mA $ values. In Type-I and Type-X at larger $\tan \beta $, the bosonic channel $\PHp \to \PWp \PA $ dominates over $\cot ^2\beta $-suppressed fermionic modes. In Type-II and Type-Y, fermionic modes are $\tan \beta $-enhanced, but this mass range is excluded by $b \to s\gamma $ ($\mHc \gtrsim 580$\GeV ). The calculation is performed with the 2HDMC~v1.8.0 library.\relax }{figure.caption.26}{}}
