\contentsline {table}{\numberline {2.2}{\ignorespaces Quantum number assignments for the first generation of fermions under $\ensuremath {\mathrm {SU}}\xspace (2)_L \times \ensuremath {\mathrm {U}}\xspace (1)_Y$. The electric charge $Q$ is related to weak isospin $I_3$ and hypercharge $Y$ through $Q = I_3 + Y$. The pattern repeats for the second and third generations.\relax }}{11}{table.caption.12}%
\contentsline {table}{\numberline {2.3}{\ignorespaces Yukawa coupling structure in the four types of 2HDM. Each fermion type couples exclusively to one doublet, enforced by the $\mathbb {Z}_2$ symmetry, thereby avoiding tree-level FCNCs.\relax }}{21}{table.caption.20}%
\contentsline {table}{\numberline {2.4}{\ignorespaces Yukawa coupling modifiers $\xi _f^{\Phi }$ for the four types of 2HDM. The SM values are $\xi _f = 1$ for all fermions coupling to the Higgs doublet. Here $c_\alpha = \cos \alpha $, $s_\alpha = \sin \alpha $, $c_\beta = \cos \beta $, $s_\beta = \sin \beta $, and $t_\beta = \tan \beta $.\relax }}{22}{table.caption.21}%
