\contentsline {figure}{\numberline {5.1}{\ignorespaces Distributions of the OS dimuon invariant mass (left), leading jet \ensuremath {p_{\mathrm {T}}}\xspace (center), and leading b-tagged jet \ensuremath {p_{\mathrm {T}}}\xspace (right) in the $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channel after baseline selection, for Run\nobreakspace {}2 (top row) and Run\nobreakspace {}3 (bottom row). Distributions are normalized to the respective cross sections, with signal cross sections set to $30\ensuremath {\text {\,fb}}\xspace $ at 13 TeV and $33.2\ensuremath {\text {\,fb}}\xspace $ at 13.6 TeV. Signal mass points of $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (70, 15)$, $(100, 60)$, $(130, 90)$, and $(160, 155)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace are shown.\relax }}{95}{figure.caption.89}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Distributions of the lower-mass OS dimuon pair (left), higher-mass OS dimuon pair (center), and \ensuremath {\ensuremath {p_{\mathrm {T}}}\xspace ^\text {miss}}\xspace (right) in the $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channel after baseline selection, for Run\nobreakspace {}2 (top row) and Run\nobreakspace {}3 (bottom row). Distributions are normalized to the respective cross sections, with signal cross sections set to $30\ensuremath {\text {\,fb}}\xspace $ at 13 TeV and $33.2\ensuremath {\text {\,fb}}\xspace $ at 13.6 TeV. Signal mass points of $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (70, 15)$, $(100, 60)$, $(130, 90)$, and $(160, 155)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace are shown.\relax }}{96}{figure.caption.90}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Fraction of correctly selecting the signal dimuon pair in the $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channel, shown across the $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace )$ plane. From left to right, the three panels show selection by lower mass, higher $\gamma $ factor, and smaller transverse mass with \ensuremath {\ensuremath {p_{\mathrm {T}}}\xspace ^\text {miss}}\xspace . The pair assignment rule is chosen per mass point based on these truth-level studies.\relax }}{98}{figure.caption.93}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Training and validation accuracy and loss curves for the ParticleNet models trained on the combined channel with $\lambda _\mathrm {decorr} = 0.1$. From top to bottom, the panels show $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (100, 95)$, $(130, 90)$, and $(160, 85)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace .\relax }}{104}{figure.caption.100}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces ROC curves comparing signal against each background class on the training and test datasets. From left to right, the panels show $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (100, 95)$, $(130, 90)$, and $(160, 85)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace . The close agreement between training and test curves confirms the absence of significant overfitting.\relax }}{106}{figure.caption.101}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Signal and background dimuon mass templates for the Run\nobreakspace {}2 dataset at $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (100, 95)$, $(130, 90)$, and $(160, 85)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace (columns). Rows show the $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ and $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channels before and after the modified LR cut.\relax }}{107}{figure.caption.106}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Signal and background dimuon mass templates for the Run\nobreakspace {}3 dataset at $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace ) = (100, 95)$, $(130, 90)$, and $(160, 85)$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace (columns). Rows show the $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ and $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channels before and after the modified LR cut.\relax }}{108}{figure.caption.107}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Modified likelihood ratio distributions in the $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}$ $\ensuremath {{\text {t}\overline {\text {t}}}}\xspace +\ensuremath {\text {Z}}\xspace $ control region. From top to bottom, the panels show $\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace = 100$, $130$, and $160$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace . From left to right, $\ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace = 85$, $90$, and $95$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace .\relax }}{110}{figure.caption.109}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Measured fake rates in data for electrons (left) and muons (right) as a function of cone-corrected $\ensuremath {p_{\mathrm {T}}}\xspace $ and $|\eta |$, for the four Run\nobreakspace {}2 data-taking periods, 2016preVFP, 2016postVFP, 2017, and 2018 (rows 1--4). Error bands represent statistical uncertainties.\relax }}{115}{figure.caption.110}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Measured fake rates in data for electrons (left) and muons (right) as a function of cone-corrected $\ensuremath {p_{\mathrm {T}}}\xspace $ and $|\eta |$, for the four Run\nobreakspace {}3 data-taking periods, 2022, 2022EE, 2023, and 2023BPix (rows 1--4). Error bands represent statistical uncertainties.\relax }}{116}{figure.caption.111}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces MC closure test comparing observed \ensuremath {{\text {t}\overline {\text {t}}}}\xspace simulation distributions (tight ID) with matrix method predictions using QCD-measured fake rates. The four rows show Run\nobreakspace {}2 $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, Run\nobreakspace {}2 $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, Run\nobreakspace {}3 $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, and Run\nobreakspace {}3 $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channels. Normalized $\chi ^{2}$/ndf values are indicated.\relax }}{121}{figure.caption.113}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Data and simulation comparison in the $\ensuremath {\text {Z}}\xspace $+nonprompt control region. The four rows show Run\nobreakspace {}2 $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, Run\nobreakspace {}3 $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, Run\nobreakspace {}2 $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$, and Run\nobreakspace {}3 $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ channels. The three columns show the $\ensuremath {\text {Z}}\xspace $ boson candidate mass, nonprompt lepton $\ensuremath {p_{\mathrm {T}}}\xspace $, and nonprompt lepton $\eta $ distributions.\relax }}{122}{figure.caption.114}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Data and simulation comparison in the $\ensuremath {\text {Z}}\xspace \ensuremath {\mathrm {\gamma }}$ control region for $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ events. The four rows show Run\nobreakspace {}2 before conversion SF correction, Run\nobreakspace {}2 after correction, Run\nobreakspace {}3 before correction, and Run\nobreakspace {}3 after correction. The three columns show the $\ensuremath {\text {Z}}\xspace $ boson candidate mass, conversion electron $\ensuremath {p_{\mathrm {T}}}\xspace $, and conversion electron $\eta $ distributions.\relax }}{124}{figure.caption.117}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Data and simulation comparison in the $\ensuremath {\text {Z}}\xspace \ensuremath {\mathrm {\gamma }}$ control region for $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ events. The four rows show Run\nobreakspace {}2 before conversion SF correction, Run\nobreakspace {}2 after correction, Run\nobreakspace {}3 before correction, and Run\nobreakspace {}3 after correction. The three columns show the $\ensuremath {\text {Z}}\xspace $ boson candidate mass, conversion muon $\ensuremath {p_{\mathrm {T}}}\xspace $, and conversion muon $\eta $ distributions.\relax }}{125}{figure.caption.118}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Data and simulation comparison in the $\ensuremath {\mathrm {W}}\ensuremath {\text {Z}}\xspace $ control region for Run\nobreakspace {}3. The four rows show $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ before jet multiplicity reweighting, $\ensuremath {\mathrm {e}}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ after reweighting, $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ before reweighting, and $\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}\ensuremath {\mathrm {\mu }}$ after reweighting. The three columns show the $\ensuremath {\text {Z}}\xspace $ boson candidate mass, leading jet $\ensuremath {p_{\mathrm {T}}}\xspace $, and jet multiplicity distributions.\relax }}{128}{figure.caption.121}%
