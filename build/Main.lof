\contentsline {figure}{\numberline {2.1}{\ignorespaces Branching fraction $\mathcal {B}(t \to \ensuremath {\ensuremath {\text {H}}\xspace ^{\pm }}\xspace b)$ in the Type-I 2HDM (2HDMC\nobreakspace {}v1.8.0). Panel (a) shows the dependence on \ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace for $\tan \beta = 1$ to 5, while panel (b) shows the $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \tan \beta )$ plane and the $\cot ^2\beta $ suppression.\relax }}{26}{figure.caption.24}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {$\mathcal {B}(t \to \ensuremath {\ensuremath {\text {H}}\xspace ^{\pm }}\xspace b)$ vs.\ \ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace for several $\tan \beta $ values}}}{26}{subfigure.1.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {$\mathcal {B}(t \to \ensuremath {\ensuremath {\text {H}}\xspace ^{\pm }}\xspace b)$ in the $(\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace , \tan \beta )$ plane}}}{26}{subfigure.1.2}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Partial widths of $\ensuremath {\text {H}^+}\xspace $ vs. $\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace $ in the four 2HDM types at $\tan \beta = 1$ and 5, for three representative $\ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace $ values. In Type-I and Type-X at larger $\tan \beta $, the bosonic channel $\ensuremath {\text {H}^+}\xspace \to \ensuremath {\mathrm {W^+}}\ensuremath {\text {A}}\xspace $ dominates over $\cot ^2\beta $-suppressed fermionic modes. In Type-II and Type-Y, fermionic modes are $\tan \beta $-enhanced, but this mass range is excluded by $b \to s\gamma $ ($\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace \gtrsim 580$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace ). The calculation is performed with the 2HDMC\nobreakspace {}v1.8.0 library.\relax }}{29}{figure.caption.26}%
\contentsline {subfigure}{\numberline {(a)}{\ignorespaces {Type-I, $\tan \beta = 1$}}}{29}{subfigure.2.1}%
\contentsline {subfigure}{\numberline {(b)}{\ignorespaces {Type-II, $\tan \beta = 1$}}}{29}{subfigure.2.2}%
\contentsline {subfigure}{\numberline {(c)}{\ignorespaces {Type-X, $\tan \beta = 1$}}}{29}{subfigure.2.3}%
\contentsline {subfigure}{\numberline {(d)}{\ignorespaces {Type-Y, $\tan \beta = 1$}}}{29}{subfigure.2.4}%
\contentsline {subfigure}{\numberline {(e)}{\ignorespaces {Type-I, $\tan \beta = 5$}}}{29}{subfigure.2.5}%
\contentsline {subfigure}{\numberline {(f)}{\ignorespaces {Type-II, $\tan \beta = 5$}}}{29}{subfigure.2.6}%
\contentsline {subfigure}{\numberline {(g)}{\ignorespaces {Type-X, $\tan \beta = 5$}}}{29}{subfigure.2.7}%
\contentsline {subfigure}{\numberline {(h)}{\ignorespaces {Type-Y, $\tan \beta = 5$}}}{29}{subfigure.2.8}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Branching ratios of $\ensuremath {\text {A}}\xspace $ vs. $\ensuremath {m_{\ensuremath {\text {A}}\xspace }}\xspace $ for $\ensuremath {m_{\ensuremath {\text {H}^+}\xspace }}\xspace = 160$\ensuremath {\,\text {Ge\hspace {-.08em}V}}\xspace in the four 2HDM types at $\tan \beta = 1$ and 5. The $b\bar {b}$ channel dominates above $2m_b$; $\mathcal {B}(\ensuremath {\text {A}}\xspace \to \ensuremath {\mathrm {\mu ^+}}\ensuremath {\mathrm {\mu ^-}}) \sim 10^{-3}$ is approximately constant. In Type-X, the $\ensuremath {\tau ^+}\xspace \ensuremath {\tau ^-}\xspace $ channel is enhanced at large $\tan \beta $ due to the lepton-specific coupling structure. The calculation is performed with the 2HDMC\nobreakspace {}v1.8.0 library.\relax }}{30}{figure.caption.28}%
